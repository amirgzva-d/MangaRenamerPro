<Application x:Class="MangaRenamerPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#0B1220"/>
    <SolidColorBrush x:Key="PanelBg" Color="#111C2E"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#17253A"/>
    <SolidColorBrush x:Key="Accent" Color="#39C6B2"/>
    <SolidColorBrush x:Key="TextMain" Color="#F3F7FC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9BAEC4"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#07131D"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1626"/>
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="BorderBrush" Value="#2A3D55"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#0B1626"/>
      <Setter Property="Foreground" Value="#F3F7FC"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Application.Resources>
</Application>
